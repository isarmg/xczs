[Unit]
Description=Xczs browser file manager
Documentation=https://github.com/isarmg/xczs/blob/main/docs/runtime-package.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isarmg-xczs
Group=isarmg-xczs
UMask=0077
WorkingDirectory=/opt/isarmg/xczs
ExecStart=/opt/isarmg/xczs/bin/xczs --root /opt/isarmg/xczs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
KillSignal=SIGTERM
LimitNOFILE=65536

NoNewPrivileges=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
# Keep this path in sync with config.json serve_path.
# The installer renders both roots from the selected JSON.
ReadWritePaths=/opt/isarmg/xczs/state /opt/isarmg/xczs/logs /opt/isarmg/xczs/run /srv/xczs
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
