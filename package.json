{
  "name": "xczs-browser-tests",
  "private": true,
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "build:platform": "node scripts/build-platform.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "check:js": "node scripts/check-js.mjs",
    "check:types": "python3 scripts/build-leptos.py check",
    "test:frontend:unit": "node --test tests/frontend/unit/*.test.mjs && npm run test:rust",
    "test:language": "npm run build:platform && node tests/frontend/language.mjs",
    "test:frontend": "node scripts/build-frontend-candidate.mjs",
    "test:frontend:run": "node scripts/run-frontend-prepared.mjs",
    "test:frontend:headed": "node scripts/build-frontend-candidate.mjs --headed",
    "test:frontend:edge": "node scripts/build-frontend-candidate.mjs --edge --project=edge",
    "test:frontend:install": "playwright install chromium firefox",
    "build:server": "xcss-build-server --config xcss-web-build.json --mode development",
    "build:server:release": "xcss-build-server --config xcss-web-build.json --mode release",
    "test:rust": "python3 scripts/build-leptos.py test"
  },
  "dependencies": {
    "@xcss/web": "https://github.com/isarmg/xcss/releases/download/v1.0.0/xcss-web-1.0.0.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.12.0",
    "vite": "8.3.3",
    "yaml": "2.9.1"
  },
  "version": "1.0.1"
}
